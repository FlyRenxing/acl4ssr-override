name: ACL4SSR · mini
desc: "Auto-generated from https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Mini.ini — do not edit output by hand."

# Generated by acl4ssr-override
# upstream: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Mini.ini
# sha256: 9c5f99e83ccb30aefec00f0a8af3173bb3168920f2f045e70dabbbc7e6dc9610
# at: 2026-08-11T09:33:26.744Z
# Stash arrays default to prepend; #!replace overwrites like overwrite_original_rules=true.

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: #!replace
    - '*.lan'
    - '*.local'
    - localhost.ptlogin2.qq.com
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback: #!replace
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
  fallback-filter: #!replace
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4

proxy-groups: #!replace
  - name: 🚀 节点选择
    type: select
    proxies:
      - ♻️ 自动选择
      - DIRECT
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
  - name: ♻️ 自动选择
    type: url-test
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🎯 全球直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
      - ♻️ 自动选择
  - name: 🛑 全球拦截
    type: select
    proxies:
      - REJECT
      - DIRECT
  - name: 🐟 漏网之鱼
    type: select
    proxies:
      - 🚀 节点选择
      - 🎯 全球直连
      - ♻️ 自动选择
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*


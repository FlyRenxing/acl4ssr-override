name: ACL4SSR · back_cn
desc: "Auto-generated from https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_BackCN.ini — do not edit output by hand."

# Generated by acl4ssr-override
# upstream: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_BackCN.ini
# sha256: beb5c7c31cb55eef4c677da2b393429216e17ae63c21549e1a1ee8a7e7830705
# at: 2026-08-18T16:16:52.752Z
# Stash arrays default to prepend; #!replace overwrites like overwrite_original_rules=true.
# Nodes: Stash keeps subscription order inside groups (override cannot re-sort proxies). Use Sub-Store to sort by name, or Network Settings → sort by latency.

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: #!replace
    - '*.lan'
    - '*.local'
    - localhost.ptlogin2.qq.com
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback: #!replace
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
  fallback-filter: #!replace
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4

proxy-groups: #!replace
  - name: 🚀 中国代理
    type: select
    proxies:
      - DIRECT
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
  - name: 🎯 全球直连
    type: select
    proxies:
      - DIRECT
      - 🚀 中国代理
  - name: 🛑 全球拦截
    type: select
    proxies:
      - REJECT
      - DIRECT
  - name: 🍃 应用净化
    type: select
    proxies:
      - REJECT
      - DIRECT
  - name: 🐟 漏网之鱼
    type: select
    proxies:
      - 🚀 中国代理
      - 🎯 全球直连
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*

rule-providers: #!replace
  g_LocalAreaNetwork:

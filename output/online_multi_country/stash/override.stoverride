name: ACL4SSR · online_multi_country
desc: "Auto-generated from https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Online_MultiCountry.ini — do not edit output by hand."

# Generated by acl4ssr-override
# upstream: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Online_MultiCountry.ini
# sha256: dd704ca71a7b94a10eec1e83a1007861d5cc716ff23ca7e632e51f5a35266c09
# at: 2026-08-15T16:09:34.639Z
# Stash arrays default to prepend; #!replace overwrites like overwrite_original_rules=true.
# Nodes: Stash keeps subscription order inside groups (override cannot re-sort proxies). Use Sub-Store to sort by name, or Network Settings → sort by latency.

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: #!replace
    - '*.lan'
    - '*.local'
    - localhost.ptlogin2.qq.com
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback: #!replace
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
  fallback-filter: #!replace
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4

proxy-groups: #!replace
  - name: 🚀 节点选择
    type: select
    proxies:
      - ♻️ 自动选择
      - 🇭🇰 香港节点
      - 🇺🇲 美国节点
      - 🇯🇵 日本节点
      - 🇸🇬 狮城节点
      - 🚀 手动切换
      - DIRECT
  - name: 🚀 手动切换
    type: select
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
  - name: ♻️ 自动选择
    type: url-test
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🌍 国外媒体
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择
      - 🎯 全球直连
    include-all: true
    filter: (?i)^(?!.*(?:(流量|官网|网址|官址|机场|套餐|应急|时间|重置|剩余|[到过]期|订阅|失联|expire|traffic|premium|GB))).*
